import requests
import pandas as pd
from bs4 import BeautifulSoup
import schedule
import time

def fetch_oi_spurt_data():
    try:
        # Replace with NSE OI Spurt data URL
        url = "https://www.nseindia.com/option-chain"
        headers = {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
        }
        
        # Make request
        session = requests.Session()
        session.get("https://www.nseindia.com", headers=headers)  # Load NSE homepage to get cookies
        response = session.get(url, headers=headers)

        # Parse HTML
        soup = BeautifulSoup(response.content, 'html.parser')
        
        # Example: Locate data in the page (adjust selectors based on the actual page)
        table = soup.find("table")  # Find the table with OI data
        df = pd.read_html(str(table))[0]  # Convert to DataFrame

        # Sort and filter top 5 by OI spurt (example logic)
        buy_top5 = df.sort_values(by="Change in OI", ascending=False).head(5)
        sell_top5 = df.sort_values(by="Change in OI", ascending=True).head(5)

        print("Top 5 Buy:")
        print(buy_top5)
        print("\nTop 5 Sell:")
        print(sell_top5)

    except Exception as e:
        print("Error fetching data:", e)

# Schedule to run daily at 9:18 AM
schedule.every().day.at("09:18").do(fetch_oi_spurt_data)

print("Script running...")

while True:
    schedule.run_pending()
    time.sleep(1)
